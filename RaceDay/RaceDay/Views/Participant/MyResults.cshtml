@model List<RaceDay.Contracts.ResultDto>

@{
    ViewData["Title"] = "My Performance History";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Performance History</h2>
        <p class="text-muted mb-0">Review your official finish times and race placements.</p>
    </div>
    <a asp-action="MyEvents" class="btn btn-outline-primary btn-sm">View My Entries</a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card shadow-sm border-0 bg-light p-5 text-center my-4">
        <div class="card-body">
            <h5 class="fw-semibold text-secondary">No recorded race results yet</h5>
            <p class="text-muted mb-0">Results will display here once the event organiser records your finish time.</p>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th class="ps-3 py-3">Event</th>
                        <th class="py-3">Date</th>
                        <th class="py-3">Category</th>
                        <th class="py-3 text-center">Finish Time</th>
                        <th class="pe-3 py-3 text-center">Position</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var res in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-bold">@res.EventName</td>
                            <td>@res.EventDate.ToString("yyyy-MM-dd")</td>
                            <td><span class="badge bg-light text-dark border">@res.CategoryName</span></td>
                            <td class="text-center font-monospace fw-bold text-primary">@res.FinishTime</td>
                            <td class="pe-3 text-center">
                                <span class="badge bg-warning text-dark px-3 py-2 fw-bold">#@res.FinishingPosition</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}