@model List<RaceDay.Contracts.EventDto>

@{
    ViewData["Title"] = "Upcoming Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Browse Events</h2>
        <p class="text-muted mb-0">Discover road races, community walks, and cycling events across South Africa.</p>
    </div>
</div>

<!-- Search & Filtering Form -->
<form asp-action="Index" method="get" class="card shadow-sm border-0 p-3 mb-4 bg-light">
    <div class="row g-3 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" class="form-control" placeholder="Search by name or city (e.g., Polokwane)..." value="@Context.Request.Query["search"]" />
        </div>
        <div class="col-md-4">
            <select name="eventType" class="form-select">
                <option value="">All Event Types</option>
                <option value="Run">Running</option>
                <option value="Walk">Walking</option>
                <option value="Cycle">Cycling</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button type="submit" class="btn btn-warning text-dark fw-bold w-100">Filter</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

@if (Model == null || !Model.Any())
{
    <div class="alert alert-info border-0 shadow-sm text-center py-4">
        No upcoming events match your filter criteria.
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ev in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    @if (!string.IsNullOrWhiteSpace(ev.BannerUrl))
                    {
                        <img src="@ev.BannerUrl" class="card-img-top" alt="@ev.EventName banner" style="height: 180px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" style="height: 180px;">
                            <span class="fs-4 fw-bold">🏁 @ev.EventType</span>
                        </div>
                    }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge bg-warning text-dark">@ev.EventType</span>
                            <span class="badge bg-light text-dark border">@ev.DistanceKm km</span>
                        </div>
                        <h5 class="card-title fw-bold">@ev.EventName</h5>
                        <p class="text-muted small mb-2">📍 @ev.Location | 📅 @ev.EventDate.ToString("yyyy-MM-dd")</p>
                        <p class="card-text text-truncate flex-grow-1">@ev.Description</p>
                        <a asp-action="EventDetails" asp-route-id="@ev.EventID" class="btn btn-outline-dark fw-semibold mt-3 w-100">
                            View Details & Categories
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}