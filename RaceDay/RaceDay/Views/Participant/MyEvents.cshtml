@model List<RaceDay.Contracts.EnrolmentDto>

@{
    ViewData["Title"] = "My Registered Events";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">My Registered Events</h2>
        <p class="text-muted mb-0">Track your entries, assigned race categories, and registration status.</p>
    </div>
    <a asp-controller="Participant" asp-action="Index" class="btn btn-outline-primary btn-sm">
        + Browse More Events
    </a>
</div>

@if (Model == null || !Model.Any())
{
    <div class="card shadow-sm border-0 bg-light p-5 text-center my-4">
        <div class="card-body">
            <h5 class="fw-semibold text-secondary">No registrations found</h5>
            <p class="text-muted mb-3">You have not entered any road runs, walks, or cycling events yet.</p>
            <a asp-controller="Participant" asp-action="Index" class="btn btn-warning text-dark fw-semibold">
                Explore Upcoming Events
            </a>
        </div>
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th scope="col" class="py-3 ps-3">Event Name</th>
                        <th scope="col" class="py-3">Selected Category</th>
                        <th scope="col" class="py-3">Registration Date</th>
                        <th scope="col" class="py-3 pe-3 text-center">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-3 fw-semibold">
                                @item.EventName
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@item.CategoryName</span>
                            </td>
                            <td>
                                @item.EnrolmentDate.ToString("yyyy-MM-dd")
                            </td>
                            <td class="pe-3 text-center">
                                @* Rubric-specific color-coded status badges: Confirmed = green, Pending = amber *@
                                @if (string.Equals(item.Status, "Confirmed", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-success px-3 py-2">Confirmed</span>
                                }
                                else if (string.Equals(item.Status, "Pending", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-warning text-dark px-3 py-2">Pending</span>
                                }
                                else if (string.Equals(item.Status, "Cancelled", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="badge bg-danger px-3 py-2">Cancelled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-3 py-2">@item.Status</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}