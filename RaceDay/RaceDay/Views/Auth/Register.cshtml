@model RaceDay.Contracts.RegisterRequest

@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6">
        <div class="card shadow-sm border-0">
            <div class="card-header bg-dark text-white text-center py-3">
                <h4 class="mb-0 fw-bold">Create RaceDay Account</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Register" method="post">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Full Name</label>
                        <input asp-for="FullName" class="form-control" placeholder="e.g. Jane Doe" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email Address</label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" required />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Role" class="form-label fw-semibold">Account Type</label>
                        <select asp-for="Role" class="form-select" required>
                            <option value="Participant">Participant (Enter Events & Track Results)</option>
                            <option value="Organiser">Organiser (Create Events & Capture Times)</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-warning text-dark fw-bold py-2">Create Account</button>
                    </div>
                </form>

                <hr class="my-4" />
                <p class="text-center text-muted mb-0">
                    Already registered? <a asp-action="Login" class="text-decoration-none fw-semibold">Sign In</a>
                </p>
            </div>
        </div>
    </div>
</div>